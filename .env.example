# Copiez ce fichier en ".env" et remplissez les valeurs. Ne committez jamais ".env".

# --- Backend FastAPI ---
# Clé que le backend exige sur chaque requête (header: Authorization: Bearer <valeur>).
# Générez-en une vous-même, par exemple avec: openssl rand -hex 32
BACKEND_API_KEY=changez-moi

# Origines autorisées pour CORS, séparées par des virgules (dev local Next.js par défaut).
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Modal ---
# Token Modal (créé via `modal token new`), nécessaire pour déployer/exécuter sur Modal.
# Ne PAS mettre la valeur ici en clair pour un usage réel : utilisez `modal secret create`
# et référencez le secret depuis backend/app/modal_app.py. Ce champ sert de rappel local.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# GPU utilisé par le déploiement Modal. Seuls T4 et L4 sont autorisés (A100
# est explicitement interdit pour Qwen 4B, voir backend/app/gpu_config.py).
# L4 est recommandé (quasi aussi rapide que A100, moins coûteux).
MODAL_GPU_TYPE=L4

# --- Frontend Next.js ---
# Le frontend a son PROPRE fichier d'environnement : frontend/.env.local
# (voir frontend/.env.local.example). BACKEND_BASE_URL et BACKEND_API_KEY y
# sont redéfinies côté serveur Next.js uniquement (jamais NEXT_PUBLIC_).
