# Copiez ce fichier en "frontend/.env.local" (jamais commité — déjà dans
# frontend/.gitignore). Next.js le charge automatiquement.
#
# Ces deux variables ne sont lues QUE côté serveur (lib/backend.ts, qui
# importe "server-only"). Le navigateur ne les voit jamais : il appelle
# toujours nos routes /api/*, jamais Modal directement.

# URL du backend. En local (backend/scripts/run_local.sh) :
#   BACKEND_BASE_URL=http://localhost:8000
# Une fois déployé sur Modal, l'URL affichée par `modal deploy` :
#   BACKEND_BASE_URL=https://<votre-workspace>--aftech-ai-platform-web.modal.run
BACKEND_BASE_URL=http://localhost:8000

# Même valeur que le secret Modal "aftech-backend-secrets" (clé BACKEND_API_KEY).
# Ne JAMAIS préfixer par NEXT_PUBLIC_ — ça l'exposerait dans le bundle navigateur.
BACKEND_API_KEY=

# URL de la fonction Modal "availability" (CPU uniquement, SANS GPU — voir
# backend/app/modal_app.py). Volontairement SÉPARÉE de BACKEND_BASE_URL (qui
# pointe vers le conteneur GPU "web") : c'est cette URL que le frontend
# interroge automatiquement (toutes les 30 s) pour savoir si l'API est
# joignable, SANS jamais réveiller ni maintenir actif le GPU. Aucune clé
# requise (ne renvoie aucune information sensible).
# En local (backend/scripts/run_local.sh), il n'y a qu'un seul serveur :
#   BACKEND_AVAILABILITY_URL=http://localhost:8000
# Une fois déployé sur Modal, l'URL affichée par `modal deploy` pour la
# fonction availability() :
#   BACKEND_AVAILABILITY_URL=https://<votre-workspace>--aftech-ai-platform-availability.modal.run
BACKEND_AVAILABILITY_URL=http://localhost:8000
